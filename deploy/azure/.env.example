# Honcho Azure runtime environment reference
#
# This file is intentionally .env-style for operator setup and review. The
# OpenTofu module does not automatically parse it. Put non-secret values in the
# `honcho_env` map in terraform.tfvars, and secret values in `honcho_secret_env`
# or the dedicated llm_*_api_key variables.
#
# Optional settings are commented out by default. Required production settings
# are either generated by OpenTofu or shown with placeholders.

# =============================================================================
# OpenTofu setup helpers
# =============================================================================
# You can export these before running tofu instead of editing terraform.tfvars.
# export TF_VAR_location=eastus
# export TF_VAR_llm_openai_api_key=sk-...
# export TF_VAR_image_tag=2026-05-25

# =============================================================================
# Generated by OpenTofu for this Azure deployment
# =============================================================================
# DB_CONNECTION_URI is generated from the private PostgreSQL Flexible Server.
# CACHE_URL is generated from Azure Managed Redis listKeys and uses rediss://.
# AUTH_JWT_SECRET is generated unless auth_jwt_secret is set in terraform.tfvars.
# DB_CONNECTION_URI=postgresql+psycopg://...
# CACHE_URL=rediss://:...@<cache>.<region>.redis.azure.net:10000/0?suppress=true
# AUTH_JWT_SECRET=...

# =============================================================================
# Application Settings
# =============================================================================
LOG_LEVEL=INFO
AUTH_USE_AUTH=true
CACHE_ENABLED=true
EMBED_MESSAGES=true
VECTOR_STORE_TYPE=pgvector
VECTOR_STORE_MIGRATED=false

# SESSION_OBSERVERS_LIMIT=10
# GET_CONTEXT_MAX_TOKENS=100000
# MAX_FILE_SIZE=5242880
# MAX_MESSAGE_SIZE=25000
# NAMESPACE=honcho
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# COLLECT_METRICS_LOCAL=false
# LOCAL_METRICS_FILE=metrics.jsonl
# REASONING_TRACES_FILE=traces.jsonl

# Disable local config loading in immutable containers.
PYTHON_DOTENV_DISABLED=1
HONCHO_CONFIG_TOML_DISABLED=1

# =============================================================================
# Database Settings
# =============================================================================
# DB_CONNECTION_URI is injected as a Container App secret by OpenTofu.
# DB_SCHEMA=public
DB_POOL_PRE_PING=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_POOL_USE_LIFO=true
# DB_POOL_CLASS=default
# DB_SQL_DEBUG=false
# DB_TRACING=false

# =============================================================================
# Authentication Settings
# =============================================================================
# AUTH_JWT_SECRET is injected as a Container App secret by OpenTofu.
# Generate manually with: uv run python scripts/generate_jwt_secret.py
# AUTH_JWT_SECRET=replace-me

# =============================================================================
# LLM Provider Keys
# =============================================================================
# Required for the built-in defaults. Prefer terraform.tfvars:
# llm_openai_api_key = "sk-..."
LLM_OPENAI_API_KEY=replace-me

# Optional direct vendor keys.
# LLM_ANTHROPIC_API_KEY=
# LLM_GEMINI_API_KEY=

# Optional provider base URLs. Most deployments should use per-feature
# MODEL_CONFIG__OVERRIDES__BASE_URL instead.
# LLM_OPENAI_BASE_URL=
# LLM_ANTHROPIC_BASE_URL=
# LLM_GEMINI_BASE_URL=

# =============================================================================
# Global LLM Settings
# =============================================================================
# LLM_DEFAULT_MAX_TOKENS=2500
# LLM_MAX_TOOL_OUTPUT_CHARS=10000
# LLM_MAX_MESSAGE_CONTENT_CHARS=2000

# =============================================================================
# Embedding Settings
# =============================================================================
# EMBEDDING_VECTOR_DIMENSIONS=1536
# EMBEDDING_MAX_INPUT_TOKENS=8192
# EMBEDDING_MAX_TOKENS_PER_REQUEST=300000
# EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
# EMBEDDING_MODEL_CONFIG__MODEL=text-embedding-3-small
# EMBEDDING_MODEL_CONFIG__DIMENSIONS_MODE=auto
# EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=
# EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY=
# EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=

# =============================================================================
# Deriver
# =============================================================================
# DERIVER_ENABLED=true
# DERIVER_WORKERS=1
# DERIVER_POLLING_SLEEP_INTERVAL_SECONDS=1.0
# DERIVER_STALE_SESSION_TIMEOUT_MINUTES=5
# DERIVER_QUEUE_ERROR_RETENTION_SECONDS=2592000
# DERIVER_DEDUPLICATE=true
# DERIVER_LOG_OBSERVATIONS=false
# DERIVER_MAX_INPUT_TOKENS=25000
# DERIVER_MAX_CUSTOM_INSTRUCTIONS_TOKENS=2000
# DERIVER_WORKING_REPRESENTATION_MAX_OBSERVATIONS=100
# DERIVER_REPRESENTATION_BATCH_MAX_TOKENS=1024
# DERIVER_FLUSH_ENABLED=false

# DERIVER_MODEL_CONFIG__TRANSPORT=openai
# DERIVER_MODEL_CONFIG__MODEL=gpt-5.4-mini
# DERIVER_MODEL_CONFIG__TEMPERATURE=
# DERIVER_MODEL_CONFIG__TOP_P=
# DERIVER_MODEL_CONFIG__TOP_K=
# DERIVER_MODEL_CONFIG__FREQUENCY_PENALTY=
# DERIVER_MODEL_CONFIG__PRESENCE_PENALTY=
# DERIVER_MODEL_CONFIG__SEED=
# DERIVER_MODEL_CONFIG__THINKING_EFFORT=minimal
# DERIVER_MODEL_CONFIG__THINKING_BUDGET_TOKENS=1024
# DERIVER_MODEL_CONFIG__MAX_OUTPUT_TOKENS=4096
# DERIVER_MODEL_CONFIG__STOP_SEQUENCES=["stop"]
# DERIVER_MODEL_CONFIG__CACHE_POLICY__MODE=none
# DERIVER_MODEL_CONFIG__CACHE_POLICY__TTL_SECONDS=300
# DERIVER_MODEL_CONFIG__CACHE_POLICY__KEY_VERSION=v1
# DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
# DERIVER_MODEL_CONFIG__OVERRIDES__API_KEY=
# DERIVER_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=DERIVER_CUSTOM_API_KEY
# DERIVER_MODEL_CONFIG__OVERRIDES__PROVIDER_PARAMS__VERBOSITY=low
# DERIVER_MODEL_CONFIG__FALLBACK__TRANSPORT=anthropic
# DERIVER_MODEL_CONFIG__FALLBACK__MODEL=claude-haiku-4-5
# DERIVER_MODEL_CONFIG__FALLBACK__OVERRIDES__BASE_URL=
# DERIVER_MODEL_CONFIG__FALLBACK__OVERRIDES__API_KEY_ENV=DERIVER_FALLBACK_API_KEY

# =============================================================================
# Peer Card
# =============================================================================
# PEER_CARD_ENABLED=true

# =============================================================================
# Dialectic
# =============================================================================
# DIALECTIC_MAX_OUTPUT_TOKENS=8192
# DIALECTIC_MAX_INPUT_TOKENS=100000
# DIALECTIC_HISTORY_TOKEN_LIMIT=8192
# DIALECTIC_SESSION_HISTORY_MAX_TOKENS=4096

# Minimal level
# DIALECTIC_LEVELS__minimal__MAX_TOOL_ITERATIONS=1
# DIALECTIC_LEVELS__minimal__MAX_OUTPUT_TOKENS=250
# DIALECTIC_LEVELS__minimal__TOOL_CHOICE=auto
# DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
# DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=gpt-5.4-mini
# DIALECTIC_LEVELS__minimal__MODEL_CONFIG__THINKING_EFFORT=minimal
# DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL=

# Low level
# DIALECTIC_LEVELS__low__MAX_TOOL_ITERATIONS=5
# DIALECTIC_LEVELS__low__TOOL_CHOICE=auto
# DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
# DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=gpt-5.4-mini

# Medium level
# DIALECTIC_LEVELS__medium__MAX_TOOL_ITERATIONS=2
# DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=openai
# DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=gpt-5.4-mini

# High level
# DIALECTIC_LEVELS__high__MAX_TOOL_ITERATIONS=4
# DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=openai
# DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=gpt-5.4-mini

# Max level
# DIALECTIC_LEVELS__max__MAX_TOOL_ITERATIONS=10
# DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=openai
# DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=gpt-5.4-mini
# DIALECTIC_LEVELS__max__MODEL_CONFIG__THINKING_EFFORT=medium
# DIALECTIC_LEVELS__max__MODEL_CONFIG__THINKING_BUDGET_TOKENS=1024
# DIALECTIC_LEVELS__max__MODEL_CONFIG__MAX_OUTPUT_TOKENS=8192
# DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL=
# DIALECTIC_LEVELS__max__MODEL_CONFIG__FALLBACK__TRANSPORT=gemini
# DIALECTIC_LEVELS__max__MODEL_CONFIG__FALLBACK__MODEL=gemini-2.5-pro

